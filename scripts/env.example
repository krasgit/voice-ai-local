# Copy/adjust as needed. run.sh sources this file automatically.

# Java app
export VOICE_PORT=8080
export MAX_TOKENS=256

# LLM (llama.cpp on :8081). CHAT_MODEL/REASONING_MODEL are the model *names*
# sent to the server; llama.cpp accepts any string, so "qwen" is fine.
export LLM_URL=http://127.0.0.1:8081/v1/chat/completions
export CHAT_MODEL=qwen
export REASONING_MODEL=qwen

# STT (whisper.cpp on :8083)
export STT_URL=http://127.0.0.1:8083/inference

# TTS (Piper). ESPEAK_BIN points at the Piper wrapper; run.sh sets a sane
# default, but you can override it here.
# export ESPEAK_BIN=./scripts/piper-tts.sh
